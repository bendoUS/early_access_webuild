# Variables d'environnement pour Google Sheets
# Copiez ce fichier en .env et remplissez les valeurs

# URL du script Google Apps Script (récupéré après le déploiement)
# Format: https://script.google.com/macros/s/VOTRE_SCRIPT_ID/exec
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/VOTRE_SCRIPT_ID/exec

# Google Analytics ID (optionnel)
# Format: G-XXXXXXXXXX (GA4) ou UA-XXXXXXXXX-X (Universal Analytics)
# Laissez vide si vous ne voulez pas utiliser Google Analytics
VITE_GA_ID=
